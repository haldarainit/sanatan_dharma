# Copy this file to .env.local and fill in the blanks.
# .env.local is gitignored; never commit real tokens.

# --- Sanity project -------------------------------------------------------
# These two are public and already default in sanity/env.ts, so the site
# builds without them. Set them only to point at a different project.
NEXT_PUBLIC_SANITY_PROJECT_ID=vxux2x60
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Write token (needed once, to seed the dataset) -----------------------
# Create at https://sanity.io/manage/project/vxux2x60/api#tokens
#   Add API token -> name it "seed" -> permission: Editor
# Shown only once, so copy it straight away. Used by `npm run sanity:seed`.
SANITY_API_WRITE_TOKEN=

# --- Webhook secret (optional) --------------------------------------------
# Not issued by anyone: you invent this string, then paste the SAME value in
# two places so the site can tell a real Sanity webhook from a stranger:
#   1. Sanity -> API -> Webhooks -> Secret
#   2. Vercel -> Settings -> Environment Variables -> SANITY_REVALIDATE_SECRET
# Without it, edits still appear -- just within 60s instead of instantly.
# Generate a fresh one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SANITY_REVALIDATE_SECRET=
