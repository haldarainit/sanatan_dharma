# Copy this file to .env.local and fill in the blanks.
# .env.local is gitignored; never commit real tokens.
#
# Every service below runs on a free tier. Nothing here costs money.

# ==========================================================================
# 1. MongoDB Atlas  —  the database          https://cloud.mongodb.com
# ==========================================================================
# Create a free M0 cluster (AWS, Mumbai ap-south-1), then:
#   Clusters -> Connect -> Drivers -> Node.js  -> copy the string
#   Network Access -> Add IP -> Allow access from anywhere (0.0.0.0/0)
#     Vercel's outbound IPs are dynamic, so an allowlist is not possible.
#     The database user's password is what protects it -- make it long.
# Replace <db_password> in the copied string with the real password.
MONGODB_URI=
MONGODB_DB=sanatan

# ==========================================================================
# 2. Resend  —  transactional email          https://resend.com
# ==========================================================================
# API keys -> Create API Key -> "Sending access" -> copy the re_... value.
# It is shown once.
RESEND_API_KEY=

# Until the domain is verified, Resend only delivers to YOUR OWN address and
# only from onboarding@resend.dev. That is enough to build and test.
#   Domains -> Add Domain -> sanatandharmngo.org -> add the DNS records it
#   shows at the registrar. Then switch EMAIL_FROM to the real address.
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=ngo.sanatandharm@gmail.com
ADMIN_NOTIFY_EMAIL=ngo.sanatandharm@gmail.com

# ==========================================================================
# 3. Cloudinary  —  photos, ID proofs, PDFs  https://cloudinary.com/console
# ==========================================================================
# The cloud name is shown at the top-left of the console.
# Settings (gear) -> API Keys -> copy the key and secret.
# ID proofs are uploaded as `type: authenticated`, so they are NOT publicly
# reachable -- the site serves them through short-lived signed URLs only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================================================
# 4. Cloudflare Turnstile  —  captcha        https://dash.cloudflare.com
# ==========================================================================
# Search "Turnstile" in the dashboard -> Add widget
#   Widget mode: Managed
#   Hostnames:   sanatandharmngo.org, sanatan-dharma-2-five.vercel.app, localhost
# Site key is public, secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ==========================================================================
# 5. Secrets you issue yourself  —  no account needed
# ==========================================================================
# Generate fresh values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# PII_KEY must be 64 hex characters (32 bytes) for AES-256:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_SECRET     signs admin and member login cookies
# DOC_VERIFY_SECRET  signs the QR token printed on receipts and ID cards.
#                    Rotating it invalidates every QR already in circulation,
#                    so treat it as permanent.
# PII_KEY            encrypts PAN numbers and ID-proof references at rest
# PII_PEPPER         hashes mobile numbers so they can be looked up without
#                    storing a searchable plaintext index
# CRON_SECRET        the header cron-job.org sends to prove a job is genuine
SESSION_SECRET=
DOC_VERIFY_SECRET=
PII_KEY=
PII_PEPPER=
CRON_SECRET=

# ==========================================================================
# 6. Site
# ==========================================================================
# Used to build QR payloads and email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================================================
# 7. Razorpay  —  OPTIONAL, ships disabled
# ==========================================================================
# Razorpay charges ~2% + GST per transaction. The UPI QR already on the site
# costs nothing. Leave these blank to run donations on the free UPI path;
# fill them in only if the client wants card / netbanking checkout.
# Test-mode keys work fully and cost nothing:
#   Razorpay Dashboard -> Settings -> API Keys (switch to Test Mode first)
#   Webhook secret: Settings -> Webhooks -> Add -> you invent the secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ==========================================================================
# 8. Sanity  —  the existing CMS (unchanged)
# ==========================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=vxux2x60
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Needed once, to seed the dataset. Create at
# https://sanity.io/manage/project/vxux2x60/api#tokens -> Editor
SANITY_API_WRITE_TOKEN=

# You invent this, then paste the SAME value into Sanity -> API -> Webhooks
# and into Vercel's environment variables. Without it, Studio edits still
# appear -- just within 60s instead of instantly.
SANITY_REVALIDATE_SECRET=
