{
  "name": "sanatan-dharma",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "legacy": "node legacy-server.js",
    "sanity:seed": "node legacy/tools/sanity-seed.mjs",
    "sanity:deploy": "sanity deploy",
    "sanity:dev": "sanity dev",
    "sanity:seed:pages": "node legacy/tools/sanity-seed-pages.mjs",
    "cms:extract": "node legacy/tools/cms-extract.js --write && node legacy/tools/cms-extract-home.js --write && node legacy/tools/cms-extract-images.js --write",
    "cms:fix-entities": "node legacy/tools/fix-entities.js --write && node legacy/tools/fix-entities-sanity.mjs --write",
    "cms:verify": "node legacy/tools/cms-verify.js",
    "check:translate": "node legacy/tools/probe-translate.js",
    "cms:campaigns": "node legacy/tools/build-campaigns.js --write && node legacy/tools/sanity-seed-campaigns.mjs --write",
    "check:campaigns": "node legacy/tools/verify-campaigns.js",
    "test": "node --experimental-strip-types --no-warnings tests/id-format.test.mts",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --experimental-strip-types --no-warnings scripts/db-setup.mts",
    "test:db": "node --experimental-strip-types --no-warnings tests/counters.test.mts"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.9",
    "mongodb": "^7.5.0",
    "next": "^15.5.23",
    "next-sanity": "^11.6.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sanity/vision": "^5.31.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "node-html-parser": "^9.0.1",
    "postcss": "^8.5.1",
    "sanity": "^5.31.1",
    "styled-components": "^6.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18"
  }
}
